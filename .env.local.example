# Supabase 프로젝트 설정(대시보드 > Project Settings > API에서 확인)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 배포된 사이트 URL (이메일 알림 등에서 절대경로 링크를 만들 때 사용)
NEXT_PUBLIC_SITE_URL=

# 공지사항 이메일 발송용 Gmail 계정 (앱 비밀번호 사용)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# 기상청 공공데이터포털 단기예보 조회서비스 API 키(이미 URL 인코딩된 형태로 그대로 사용)
WEATHER_API_KEY=
